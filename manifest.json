{
  "manifest_version": 3,
  "name": "Netflix Dual Official Subs",
  "version": "0.3.0",
  "description": "Show a second official Netflix subtitle track as an overlay in Safari.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png",
    "1024": "icons/icon-1024.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://*.nflxvideo.net/*",
    "https://*.netflix.net/*",
    "https://*.netflix.com/*"
  ],
  "action": {
    "default_title": "Dual Subs",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "64": "icons/icon-64.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-hook.js"
      ],
      "matches": [
        "https://www.netflix.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "netflix-dual-official-subs@example.local"
    }
  }
}
